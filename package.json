{
  "name": "manetka",
  "version": "0.2.1",
  "private": true,
  "description": "Локальный менеджер личных VPN-серверов",
  "author": "maNETka",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/check-ui.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:electron": "node scripts/smoke-electron.mjs",
    "test:keys-ui": "node scripts/check-ssh-keys-ui.mjs",
    "test:progress-ui": "node --import tsx scripts/check-provisioning-ui.mjs",
    "test:vaults-ui": "node scripts/check-vault-files-ui.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "1.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "app.manetka.desktop",
    "productName": "maNETka",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "artifactName": "maNETka-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "manetka",
        "name": "maNETka Vault",
        "role": "Editor",
        "mimeType": "application/x-manetka-vault"
      },
      {
        "ext": "monetka",
        "name": "maNETka Vault (legacy)",
        "role": "Editor",
        "mimeType": "application/x-monetka-vault"
      }
    ]
  }
}
